import java.util.Scanner;

public class Main {

    // 최대공약수 (유클리드 호제법)
    static int gcd(int a, int b) {
        while (b != 0) {
            int r = a % b;
            a = b;
            b = r;
        }
        return a;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int A = sc.nextInt();
        int B = sc.nextInt();

        int gcd = gcd(A, B);
        int lcm = A * B / gcd;

        System.out.println(gcd);
        System.out.println(lcm);
    }
}
